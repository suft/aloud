{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aloud",
  "version": "0.1.0",
  "identifier": "io.github.suft.aloud",
  "mainBinaryName": "aloud",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aloud",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "dmg",
      "app",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/espeak-ng-data/": "espeak-ng-data/"
    },
    "category": "Utility",
    "license": "GPL-3.0-or-later",
    "shortDescription": "Turn any EPUB into an audiobook on your computer.",
    "longDescription": "Aloud turns a DRM-free English EPUB into a chaptered M4B audiobook using the Kokoro voice model. Everything runs on your computer; nothing is uploaded."
  }
}
